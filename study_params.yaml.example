# =============================================================================
# study_params.yaml
# Settings for ONE synthetic-dataset repo (a -synth repo).
#
# This file holds only what this repo needs to GENERATE and QC the dataset:
# its identity, where it is loaded, and descriptive metadata. It does NOT define
# cohorts, outcomes or covariates. What the dataset must contain is defined by the
# studies that will use it, listed in consumers.yaml; their own cohort
# definitions (in their Strategus repos) are read directly, so nothing is copied
# or hand-maintained here:
#   workflow/02  lists those studies' cohorts
#   workflow/03  checks the Synthea module can produce them
#   workflow/06  checks the final data contains them
#
# SETUP ORDER:
#   1. Fill in every TODO in this file and in consumers.yaml
#   2. Rscript scripts/find_todos.R          # remaining placeholders
#   3. Rscript scripts/check_setup.R         # [OK] / [WARN] / [FAIL] checklist
#   4. Rscript workflow/02_define_omop_cohort_outcome_covariates.R   # consumers' cohorts
#   5. Design the Synthea module, then run workflows 03-06 and register the dataset
#      in synthetic_data/registry.yaml. See README.md.
#
# CONCEPT IDs: this repo contains none. Concept sets live in the consuming
# studies' cohort definitions and follow Rule 1 (CLAUDE.md) there.
# =============================================================================

# =============================================================================
# STUDY IDENTITY
# =============================================================================
study_name: "my_study"   # TODO [CONFIG]: lowercase, underscores only; used in output file names

# =============================================================================
# DATABASE SCHEMAS
# =============================================================================
# CDM schema populated by workflow/05 (the ETL). Must be set explicitly: the CDM
# is a shared dataset, so it cannot be derived from study_name.
cdm_schema: "cdm_my_study"   # TODO [CONFIG]

# Optional. Results schema (Achilles / DQD output and QC scratch tables) defaults
# to <study_name>_results. Uncomment only for a non-standard name.
# results_schema: "my_study_results"

# =============================================================================
# OUTPUT
# =============================================================================
# Defaults to output/<study_name> when omitted.
# Uncomment and set only if you need a non-standard output path.
# output_folder: ~

# =============================================================================
# DATABASE METADATA
# Descriptive metadata recorded for the generated dataset.
# =============================================================================
cdm_database_id:          "my_cdm_v5.4"                                            # TODO [CONFIG]
cdm_database_name:        "My Study Database"                                       # TODO [CONFIG]
cdm_database_description: "Brief description of the patient population and database."  # TODO [CONFIG]
