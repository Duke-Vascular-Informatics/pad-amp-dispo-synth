# =============================================================================
# .env.example — Environment Variables (data-generation-only repo)
#
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed to version control.
#
# This is a data-generation-only repo (Steps 1-6). It has no analysis or
# portable-bundle step, so there is no GitLab bundle config here. Schemas and
# CDM metadata (cdm_schema, cdm_database_*) live in study_params.yaml. Shared
# values (SQL Server container, API keys, base OMOP connection details, JDBC
# wrapper, and the OMOP vocabulary CSV dir OHDSI_VOCAB_CSV_DIR used by Step 5)
# live in the workspace .env.
#
# Load order:
#   1. Devcontainer loads /workspace/.env into the container environment.
#   2. .Rprofile loads this repo's .env when R starts in this directory.
# =============================================================================

# -----------------------------------------------------------------------------
# Source repository — GitHub remote (reference)
# Documentation only; the active remote is configured via `git remote -v`.
# -----------------------------------------------------------------------------
STUDY_GITHUB_REMOTE=https://github.com/Duke-Vascular-Informatics/pad-amp-dispo-synth.git
