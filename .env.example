# =============================================================================
# .env.example — Analysis-Specific Environment Variables (Study Template)
#
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed to version control.
#
# Scope: this file contains ONLY analysis-specific variables that have no
# home elsewhere — namely the GitHub origin (reference) and the GitLab
# bundle remote + git identity used by workflow/09. Schemas and CDM metadata
# (cdm_schema, results_schema, cdm_database_*) live in study_params.yaml.
# Shared values (SQL Server container, API keys, base OMOP connection
# details, institutional CDM/results schemas, JDBC wrapper) live in the
# workspace .env.
#
# Load order:
#   1. Devcontainer loads /workspace/.env into the container environment.
#   2. .Rprofile loads this study's .env when R starts in this directory.
#   3. workflow/09_build_portable_analysis_bundle.sh loads workspace .env
#      then this .env (per-study overrides workspace).
# =============================================================================

# -----------------------------------------------------------------------------
# Source repository — GitHub remote (reference)
# Documentation only; the active remote is configured via `git remote -v`.
# -----------------------------------------------------------------------------
STUDY_GITHUB_REMOTE=https://github.com/adam-mdmph/synthea-omop-template.git

# -----------------------------------------------------------------------------
# Transportable bundle — Git remote and identity for bundle deployment
# Used by workflow/09_build_portable_analysis_bundle.sh
#
# BUNDLE_GITLAB_REMOTE points to the institutional GitLab project that
# receives the portable bundle (analysis code + .env stripped of secrets).
# Create the project on your GitLab first, then paste its SSH URL here.
# -----------------------------------------------------------------------------
BUNDLE_GITLAB_REMOTE=git@your.gitlab.instance:yourorg/your-bundle.git
BUNDLE_GIT_USER_NAME=Your Name
BUNDLE_GIT_USER_EMAIL=your.email@institution.edu
